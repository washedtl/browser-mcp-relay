{
  "manifest_version": 3,
  "name": "browser-mcp-relay cookie bridge",
  "version": "0.4.0",
  "minimum_chrome_version": "119",
  "description": "Syncs your allowed browser logins into the relay's broker browser. Banking, email and other sensitive sites are never synced.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["cookies", "storage", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Cookie bridge"
  }
}
